# ~/.claude — repo portable de configuración de Claude Code.
# Regla: viaja la CONFIGURACIÓN, nunca el estado, los secretos ni los transcripts.

# --- Secretos / credenciales ---
.credentials.json
settings.local.json
*.pem
*.key

# --- Estado de sesión y transcripts ---
projects/*
!projects/*/
projects/*/*
# Solo la memoria de la máquina canónica se versiona. En otra máquina el slug
# cambia (projects/-Users-alan/…) y esa copia queda ignorada a propósito: una
# sola fuente de verdad. Si cambias de máquina canónica, cambia esta línea.
!projects/-home-richer/memory/
projects/-home-richer/memory/*
!projects/-home-richer/memory/*.md

# El hook memory-repo-symlink crea este directorio cuando trabajas con el cwd
# dentro de ~/.claude. No es la memoria canónica.
/memory/
sessions/
teams/
tasks/
todos/
plans/
history.jsonl
shell-snapshots/
session-env/
paste-cache/
ide/

# --- Caches y datos generados ---
plugins/
context-mode/
mcp-memory/
file-history/
cache/
image-cache/
backups/
statsig/
debug/
__pycache__/
*.pyc

# --- Basura de runtime ---
*.log
.caveman-mode-log.jsonl
.caveman-nudge-shown
.caveman-sessions/
context-tokens*.json
.last-*
.last_inuse_sweep
agent-flow/*.json
# Estado que Claude Code escribe solo (feedback drafts, telemetría, política
# remota de la cuenta). No es configuración.
feedback/
telemetry/
policy-limits.json
remote-settings.json

# --- Respaldos manuales ---
*.bak
*.bak-*
*.bak.*
*.orig
*.rej

# --- macOS ---
.DS_Store
agent-flow/rig/resultados*.json
# --- Perfiles por máquina ---
# Solo viajan el perfil de la máquina canónica y la plantilla de ejemplo.
bootstrap/machines/*.env
!bootstrap/machines/cachyos-richer.env
!bootstrap/machines/ejemplo-mac.env


# Marca del export, no se versiona
.generado-por-publicar-sh
