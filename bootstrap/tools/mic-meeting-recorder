""".strip()

# Contexto personal opcional: proyectos del vault, colaboradores y reglas de
# ruteo de wikilinks. No viaja en el repo. Ejemplo de contenido:
#
#   Proyectos disponibles en el vault (usa el path completo entre corchetes dobles):
#   - [[Projects/mi-proyecto]] — descripción corta
#
#   Colaboradores conocidos y sus proyectos:
#   - Fulano → solo participa en mi-proyecto
CONTEXTO_FILE = HOME / ".config/mic-meeting-recorder/contexto.md"


def claude_system_prompt() -> str:
    """System prompt base + el contexto personal del usuario, si existe."""
    try:
        extra = CONTEXTO_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return CLAUDE_SYSTEM_PROMPT
    return f"{CLAUDE_SYSTEM_PROMPT}\n\n{extra}" if extra else CLAUDE_SYSTEM_PROMPT


FS_SAFE_RE = re.compile(r'[<>:"/\\|?*\n\r\t]+')


def fs_safe_title(title: str, max_len: int = 60) -> str:
    """Normaliza un título para que sirva como nombre de archivo."""
    t = FS_SAFE_RE.sub(" ", title).strip()
    t = re.sub(r"\s+", " ", t)
    if len(t) > max_len:
        t = t[:max_len].rsplit(" ", 1)[0]
    return t or "sin-titulo"


def call_claude(transcript: str) -> str:
    """
    Invoca `claude -p --bare` con el transcript y devuelve el markdown generado.
    Retorna '' si falla. Usa la suscripción Max del usuario, sin costo API extra.
    """
    user_prompt = (
        "Estructura la siguiente transcripción de junta como una nota de Obsidian "
        "siguiendo el formato indicado en las instrucciones del sistema.\n\n"
        f"TRANSCRIPT:\n{transcript}"
    )
    # Sin --bare: --bare requiere ANTHROPIC_API_KEY y no usa OAuth de Max.
    # --exclude-dynamic-system-prompt-sections evita meter cwd/env/git-status
    # en el system prompt (más limpio para este caso headless).
    cmd = [
        CLAUDE_CLI, "-p",
        "--append-system-prompt", claude_system_prompt(),
        "--exclude-dynamic-system-prompt-sections",
        user_prompt,
    ]
    # 2 intentos: fallas transitorias del CLI (rc=1 en segundos) tiraban la
    # nota entera a fallback; un reintento con pausa las absorbe.
    for intento in (1, 2):
        try:
            result = subprocess.run(
                cmd, capture_output=True, text=True, timeout=CLAUDE_TIMEOUT,
            )
        except subprocess.TimeoutExpired:
            log(f"claude timeout tras {CLAUDE_TIMEOUT}s (intento {intento})")
            result = None
        except FileNotFoundError:
            log(f"claude CLI no encontrado en {CLAUDE_CLI}")
            return ""
        if result is not None and result.returncode == 0:
            return result.stdout.strip()
        if result is not None:
            # el CLI a veces manda el error a stdout con stderr vacío
            detalle = (result.stderr.strip() or result.stdout.strip())[:300]
            log(f"claude fallo rc={result.returncode} (intento {intento}): {detalle}")
        if intento == 1:
            time.sleep(20)
    return ""


def extract_title(claude_output: str) -> str:
    """Extrae el título del markdown (primera línea que empieza con '# ')."""
    for line in claude_output.splitlines():
        line = line.strip()
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def parse_proyecto(claude_output: str) -> tuple[str, str]:
    """
    Extrae la línea `PROYECTO: <valor>` del inicio de la salida de Claude.
    Devuelve (proyecto, markdown_sin_esa_línea). Si no viene, o el valor no
    está en ROUTES ni es "otro", clasifica como "otro" (fallback seguro).
    """
    lines = claude_output.splitlines()
    if lines and lines[0].strip().upper().startswith("PROYECTO:"):
        valor = lines[0].split(":", 1)[1].strip().lower()
        resto = "\n".join(lines[1:]).lstrip("\n")
        return (valor if valor in ROUTES or valor == "otro" else "otro"), resto
    return "otro", claude_output


def discord_webhook_url() -> str:
    """Lee la URL del webhook desde env o archivo de config. Vacío si no está configurado."""
    url = os.environ.get("DISCORD_WEBHOOK_URL", "").strip()
    if url:
        return url
    try:
        return DISCORD_WEBHOOK_FILE.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return ""


def notify_discord(note_path: Path, title: str) -> None:
    """POST del .md al webhook de Discord. Si falla o no hay webhook, solo loguea y sigue."""
    url = discord_webhook_url()
    if not url:
        log("discord: sin DISCORD_WEBHOOK_URL ni ~/.config/mic-meeting-recorder/discord_webhook, omitiendo")
        return
    try:
        proc = subprocess.run(
            [
                "curl", "-fsS",
                # comillas alrededor del path: curl -F trata ',' y ';' como
                # separadores y truena con títulos que llevan coma (exit 26)
                "-F", f'file=@"{note_path}"',
                "-F", f"content=📝 Nueva nota de junta: {title}",
                url,
            ],
            capture_output=True, text=True, timeout=30,
        )
        if proc.returncode != 0:
            log(f"discord: falló el POST ({(proc.stderr or proc.stdout)[:200]})")
    except Exception as e:
        log(f"discord: error al notificar: {e}")


def write_outputs(audio_path: Path, duration: float, transcript: str) -> Path | None:
    """Escribe .transcript.txt + nota .md estructurada por Claude. Devuelve el path de la nota."""
    slug = audio_path.stem  # 2026-08-27_143012
    transcript_path = audio_path.with_suffix(".transcript.txt")
    transcript_path.write_text(transcript, encoding="utf-8")

    fecha = slug[:10]
    hh = slug[11:13]
    mm = slug[13:15]
    hora = f"{hh}:{mm}"
    dur_min = duration / 60
    proyecto = "otro"

    # Si el transcript está vacío o casi vacío, no vale la pena llamar a Claude.
    if len(transcript.strip()) < 40:
        log(f"transcript casi vacío ({len(transcript)} chars), skip Claude")
        body = f"# Junta {fecha} {hora}\n\n## Contexto\nTranscript sin contenido significativo.\n"
        title = f"Junta {fecha} {hora}"
    else:
        log("llamando a claude para estructurar nota...")
        t0 = time.time()
        raw = call_claude(transcript)
        dt = time.time() - t0
        log(f"claude respondió en {dt:.1f}s ({len(raw)} chars)")
        proyecto, body = parse_proyecto(raw) if raw else ("otro", raw)
        title = extract_title(body)
        if not body or not title:
            log("claude falló o sin título — fallback a nota mínima")
            proyecto = "otro"
            body = f"# Junta {fecha} {hora}\n\n## Transcripción\n\n{transcript}\n"
            title = f"Junta {fecha} {hora}"

    dest_dir, extra_tags = ROUTES.get(proyecto, DEFAULT_ROUTE)
    dest_dir.mkdir(parents=True, exist_ok=True)
    tags = ", ".join([*extra_tags, "auto-transcript"])
    log(f"proyecto clasificado: {proyecto} → {dest_dir}")

    frontmatter = f"""---
tags: [{tags}]
fecha: {fecha}
hora: "{hora}"
duracion_min: {dur_min:.1f}
transcript: "{transcript_path}"
transcripcion_auto: true
---

"""
    note = frontmatter + body + "\n"

    safe_title = fs_safe_title(title)
    filename = f"{fecha} - {safe_title}.md"
    note_path = dest_dir / filename

    # Colisión: agrega sufijo con la hora si ya existe.
    if note_path.exists():
        note_path = dest_dir / f"{fecha} {hh}{mm} - {safe_title}.md"

    note_path.write_text(note, encoding="utf-8")
    log(f"NOTE → {note_path}")

    if proyecto in DISCORD_PROJECTS:
        notify_discord(note_path, title)

    if DELETE_AUDIO_AFTER_NOTE:
        try:
            audio_path.unlink()
            log(f"AUDIO borrado ({audio_path.name})")
        except FileNotFoundError:
            pass

    return note_path


def process_recording(audio_path: Path, duration: float) -> None:
    if duration < MIN_RECORDING_SECONDS:
        log(f"drop ({duration:.1f}s < {MIN_RECORDING_SECONDS}s)")
        try:
            audio_path.unlink()
        except FileNotFoundError:
            pass
        return
    log(f"transcribiendo {audio_path.name}...")
    t0 = time.time()
    txt = transcribe(audio_path)
    dt = time.time() - t0
    log(f"transcript listo en {dt:.1f}s ({len(txt)} chars)")
    write_outputs(audio_path, duration, txt)


def main() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    rec = Recorder()
    active_since: float | None = None
    last_stop: float = 0.0

    log(f"daemon start — mic={MIC_SOURCE}")
    log(f"trigger={MIN_ACTIVE_SECONDS}s activo, min duración={MIN_RECORDING_SECONDS}s, cooldown={COOLDOWN_SECONDS}s")

    def shutdown(*_: object) -> None:
        log("señal de shutdown, cerrando...")
        if rec.running:
            result = rec.stop()
            if result:
                path, dur = result
                # Procesa síncronamente para no perder el audio al morir el daemon.
                process_recording(path, dur)
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    while True:
        try:
            n = count_mic_consumers()
        except Exception as e:
            log(f"error contando consumers: {e}")
            n = 0
        now = time.time()

        if not rec.running:
            if n > 0:
                if active_since is None:
                    active_since = now
                    log(f"mic activo (consumers={n}), esperando {MIN_ACTIVE_SECONDS}s...")
                elif now - active_since >= MIN_ACTIVE_SECONDS:
                    if now - last_stop < COOLDOWN_SECONDS:
                        log(f"en cooldown ({int(COOLDOWN_SECONDS - (now - last_stop))}s restantes)")
                        # No arranca, pero mantiene el active_since para reintentar
                    else:
                        rec.start()
                        active_since = None
            else:
                if active_since is not None:
                    log("mic liberado antes del trigger")
                active_since = None
        else:
            # Grabando: paramos cuando el mic queda libre.
            if n == 0:
                result = rec.stop()
                last_stop = time.time()
                if result:
                    path, dur = result
                    # Procesa en background para no bloquear el detector.
                    threading.Thread(
                        target=process_recording, args=(path, dur), daemon=True
                    ).start()

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    main()
