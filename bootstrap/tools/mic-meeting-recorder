#!/usr/bin/env python3
"""
mic-meeting-recorder
====================

Daemon que:
  1. Monitorea PipeWire para detectar cuándo se activa el micrófono integrado.
  2. Si el mic queda activo más de MIN_ACTIVE_SECONDS → arranca ffmpeg
     grabando mic + audio del sistema mezclados en un opus mono 16kHz.
  3. Cuando el mic se libera → detiene la grabación.
  4. Si duró más de MIN_RECORDING_SECONDS → transcribe con faster-whisper
     (modelo medium, local) y escribe:
        - ~/Videos/meetings/YYYY-MM-DD_HHMMSS.opus       (audio)
        - ~/Videos/meetings/YYYY-MM-DD_HHMMSS.transcript.txt
        - una nota .md en el vault, clasificada por Claude según el proyecto
          (ver ROUTES): huella/biocheck se queda en ~/Notes/Meetings/, el
          resto va a ~/Notes/Projects/<proyecto>/. Si no clasifica, cae a
          ~/Notes/Meetings/ (fallback seguro). Si el proyecto es biocheck o
          huella-interop, además se manda la nota a Discord (DISCORD_WEBHOOK_URL).
     Grabaciones más cortas se descartan (evita ruido de wake-word, etc.).

Config al inicio del script. Sin dependencias fuera del venv de faster-whisper.
"""
from __future__ import annotations

import os
import re
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

# ---------- Config ----------
HOME = Path.home()
MIC_SOURCE = "alsa_input.pci-0000_03_00.6.HiFi__Mic1__source"
# Segundos de actividad continua del mic antes de arrancar a grabar.
MIN_ACTIVE_SECONDS = 3
# Duración mínima grabada para conservar y transcribir. Si es menor, se tira.
MIN_RECORDING_SECONDS = 60
# Segundos entre el fin de una grabación y que se acepte otra.
COOLDOWN_SECONDS = 30
# Intervalo del loop de polling del mic.
POLL_INTERVAL = 1.0
# Estado del daemon (para banderas y health-check).
STATE_DIR = HOME / ".local/state/mic-meeting-recorder"

VIDEOS_DIR = HOME / "Videos" / "meetings"
NOTES_DIR = HOME / "Notes" / "Meetings"
PROJECTS_DIR = HOME / "Notes" / "Projects"

# Ruteo por proyecto: carpeta destino + tags extra (se les agrega "auto-transcript").
# "biocheck"/"huella-interop" se quedan en Meetings (son las juntas reales del tema huella).
# Cualquier proyecto no listado, "otro", o que Claude no logre clasificar cae en DEFAULT_ROUTE
# (fallback seguro a Meetings, igual que antes de este cambio).
ROUTES: dict[str, tuple[Path, list[str]]] = {
    "biocheck": (NOTES_DIR, ["meeting", "biocheck", "huella"]),
    "huella-interop": (NOTES_DIR, ["meeting", "huella-interop", "huella"]),
    "lemut": (PROJECTS_DIR / "lemut_n8n", ["nota", "lemut-n8n"]),
    "fhir": (PROJECTS_DIR / "fhir-agent-poc", ["nota", "fhir-poc"]),
    "tiktok": (PROJECTS_DIR / "tiktok-edits", ["nota", "tiktok-edits"]),
    "cimat": (PROJECTS_DIR / "cimat-rest-mex", ["nota", "cimat"]),
}
DEFAULT_ROUTE: tuple[Path, list[str]] = (NOTES_DIR, ["meeting"])
# Proyectos para los que además se manda la nota a Discord.
DISCORD_PROJECTS = {"biocheck", "huella-interop"}
DISCORD_WEBHOOK_FILE = HOME / ".config/mic-meeting-recorder/discord_webhook"

WHISPER_VENV_PY = HOME / ".local/share/mic-meeting-recorder/venv/bin/python"
WHISPER_MODEL = "medium"
WHISPER_LANG = "es"
# int8 usa mucho menos RAM y es más rápido en CPU sin pérdida grande de calidad.
WHISPER_COMPUTE_TYPE = "int8"

# Claude Code CLI headless — usa la suscripción Max del usuario, sin costo API extra.
CLAUDE_CLI = "claude"
CLAUDE_TIMEOUT = 180  # segundos
# Se borra el .opus tras nota exitosa (queda .transcript.txt + .md).
DELETE_AUDIO_AFTER_NOTE = True
# ----------------------------


def log(msg: str) -> None:
    ts = datetime.now().strftime("%H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)


def run(cmd: list[str]) -> str:
    """Run and return stdout as text. Empty string on failure."""
    try:
        return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def default_monitor() -> str:
    sink = run(["pactl", "get-default-sink"]).strip()
    return f"{sink}.monitor" if sink else ""


def source_id_to_name() -> dict[str, str]:
    """Map de source_index → source_name usando `pactl list short sources`."""
    m: dict[str, str] = {}
    for line in run(["pactl", "list", "short", "sources"]).splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            m[parts[0]] = parts[1]
    return m


SELF_APP_NAME = "mic-meeting-recorder"


def count_mic_consumers() -> int:
    """
    Cuenta source-outputs activos conectados a MIC_SOURCE, EXCLUYENDO al propio
    ffmpeg del daemon (marcado con application.name=mic-meeting-recorder).
    Sin esta exclusión el daemon nunca vería n=0 para detener la grabación.
    """
    src_map = source_id_to_name()
    if not src_map:
        return 0
    text = run(["pactl", "list", "source-outputs"])
    count = 0
    # `pactl list source-outputs` produce bloques "Source Output #N\n\t...".
    for block in re.split(r"\n(?=Source Output #)", text):
        if not block.startswith("Source Output #"):
            continue
        m = re.search(r"^\s*Source: (\d+)", block, re.MULTILINE)
        if not m:
            continue
        if src_map.get(m.group(1)) != MIC_SOURCE:
            continue
        if f'application.name = "{SELF_APP_NAME}"' in block:
            continue
        count += 1
    return count


class Recorder:
    def __init__(self) -> None:
        self.proc: subprocess.Popen | None = None
        self.start_ts: float | None = None
        self.audio_path: Path | None = None

    @property
    def running(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def start(self) -> None:
        VIDEOS_DIR.mkdir(parents=True, exist_ok=True)
        ts = datetime.now().strftime("%Y-%m-%d_%H%M%S")
        self.audio_path = VIDEOS_DIR / f"{ts}.opus"
        monitor = default_monitor()

        # -name (opción del demuxer pulse) setea application.name en el stream
        # de PulseAudio para que count_mic_consumers pueda excluir a este ffmpeg.
        # Sin esto, application.name queda como "Lavf62.x.x" (default de libav)
        # y el daemon se cuenta a sí mismo → nunca ve n=0 → nunca para.
        inputs = ["-f", "pulse", "-name", SELF_APP_NAME, "-i", MIC_SOURCE]
        filter_str = "[0:a]aresample=async=1[out]"
        if monitor:
            inputs += ["-f", "pulse", "-name", SELF_APP_NAME, "-i", monitor]
            filter_str = (
                "[0:a]aresample=async=1[a0];"
                "[1:a]aresample=async=1[a1];"
                "[a0][a1]amix=inputs=2:duration=longest:dropout_transition=2[out]"
            )

        cmd = [
            "ffmpeg", "-y", "-hide_banner", "-loglevel", "warning",
            *inputs,
            "-filter_complex", filter_str,
            "-map", "[out]",
            "-c:a", "libopus", "-b:a", "32k", "-ar", "16000", "-ac", "1",
            str(self.audio_path),
        ]
        # stdin=PIPE para poder mandarle 'q' y que cierre limpio.
        self.proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        self.start_ts = time.time()
        log(f"REC start → {self.audio_path.name}")

    def stop(self) -> tuple[Path, float] | None:
        if not self.proc or self.start_ts is None or self.audio_path is None:
            return None
        duration = time.time() - self.start_ts
        # 'q' + newline le pide a ffmpeg cierre limpio (finaliza el opus).
        try:
            if self.proc.stdin:
                self.proc.stdin.write(b"q\n")
                self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.send_signal(signal.SIGINT)
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
        log(f"REC stop  ({duration:.1f}s)")
        result = (self.audio_path, duration)
        self.proc = None
        self.start_ts = None
        self.audio_path = None
        return result


def transcribe(audio_path: Path) -> str:
    """Corre faster-whisper en el venv y devuelve el transcript con timestamps."""
    script = f"""
import sys
from faster_whisper import WhisperModel
model = WhisperModel({WHISPER_MODEL!r}, device="cpu", compute_type={WHISPER_COMPUTE_TYPE!r})
segments, info = model.transcribe(
    {str(audio_path)!r},
    language={WHISPER_LANG!r},
    vad_filter=True,
    vad_parameters=dict(min_silence_duration_ms=500),
    beam_size=5,
)
for seg in segments:
    m1, s1 = divmod(seg.start, 60)
    m2, s2 = divmod(seg.end, 60)
    ts = f"[{{int(m1):02d}}:{{s1:05.2f}} → {{int(m2):02d}}:{{s2:05.2f}}]"
    print(f"{{ts}} {{seg.text.strip()}}", flush=True)
"""
    proc = subprocess.run(
        [str(WHISPER_VENV_PY), "-c", script],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        log(f"whisper stderr: {proc.stderr[:500]}")
    return proc.stdout


CLAUDE_SYSTEM_PROMPT = """
Eres un asistente que estructura notas de juntas para un vault de Obsidian. Reglas ESTRICTAS:

- NUNCA uses emojis, ni en el título ni en el cuerpo.
- Escribe en español mexicano natural, primera persona plural cuando aplique.
- NO inventes información: si algo no aparece en el transcript, no lo pongas. Si no hay decisiones, escribe "Ninguna". Si no hay action items, escribe "Ninguno".
- NO copies el transcript completo — resume las ideas.
- Sé conciso: puntos cortos, sin relleno.
- Salida: la PRIMERA línea es exactamente `PROYECTO: <valor>` (ver catálogo abajo), luego un salto de línea en blanco, y después el markdown empezando con "# " (título). Nada antes de "PROYECTO:", nada después del markdown, sin bloques de código envolventes.

Catálogo de proyectos para la línea PROYECTO (usa exactamente uno de estos valores, en minúsculas):
- biocheck — sistema de asistencia biométrico: kiosko, huella, PIN, correos DVI/DAD, registro con CURP
- huella-interop — módulo de identidad/interoperabilidad de huella del Framework Bot (control de asistencia, lector U.are.U, ISO 19794-2)
- lemut — bot de citas de barbería en n8n: Telegram, WhatsApp, RAG, pagos, agenda, escalamiento multi-cliente, Framework Bot
- fhir — agente FHIR y datos dinámicos: KQL, jsonb, Postgres, ingesta de archivos FHIR
- tiktok — edits, brainrot, novelas, recortes, retro de videojuegos para TikTok
- cimat — diplomado CIMAT, reto Rest-Mex, TensorFlow/PyTorch
- otro — cualquier otra cosa que no encaje en las anteriores (ej. trámites personales)

Formato exacto (mantén los headings tal cual):

# Título corto de 3 a 6 palabras (relacionado al tema real de la junta)

