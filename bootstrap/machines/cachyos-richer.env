# Perfil de máquina: cachyos-richer (CachyOS + Omarchy, laptop de Alan).
# Lo lee bootstrap.sh cuando $(hostname) coincide con el nombre del archivo.
# Solo valores que cambian de máquina a máquina. NADA de secretos.

# --- Audio del grabador de juntas ---
# Fuente del micrófono integrado, tal como la lista `pactl list short sources`.
# bootstrap.sh la inyecta en la copia instalada de ~/.local/bin/mic-meeting-recorder.
# Si cambias de laptop o de tarjeta, este es el valor a actualizar.
MIC_SOURCE="alsa_input.pci-0000_03_00.6.HiFi__Mic1__source"

# El audio del sistema NO se configura aquí: el script lo resuelve solo con
# `pactl get-default-sink` y le agrega `.monitor`. En Linux con PipeWire eso basta.

# --- Servicios que se habilitan en esta máquina ---
# omniroute queda fuera: en esta laptop se levanta a mano cuando se ocupa el bot.
SERVICES_ENABLE="agent-flow centro-mando ollama mic-meeting-recorder"

# --- Rutas locales ---
# Ollama vive fuera de /usr en esta máquina (instalación de usuario, sin sudo).
OLLAMA_BIN="$HOME/.local/ollama/bin/ollama"

# --- Notas de la máquina ---
# - No hay sudo con TTY. Para escalar privilegios se usa pkexec.
# - Node lo administra mise (26.1.0). Los npm globals caen en el prefix de mise.
# - El vault de Obsidian vive en ~/Notes y NO viaja en este repo.
