# Mac del trabajo (Slalom). `hostname -s` = D99MFVLWP6.

# --- Audio ---
# El grabador de juntas en esta Mac vive en ~/.meeting-recorder (watcher.py,
# detect.py, process.py) y se lanza como app bundle desde launchd, no desde el
# bootstrap; copia de referencia en bootstrap/tools/meeting-recorder-mac/.
# MIC_SOURCE decide cómo captura:
#   auto     (default) Revisa al arrancar cada grabación si SwitchAudioSource ve
#            un dispositivo Corsair conectado; si sí, usa el modo "corsair", si no,
#            el modo "mac". Evita quedarse pegado al Aggregate Device cuando el
#            headset está desconectado (grabación muda por canal muerto).
#   corsair  Aggregate Device (BlackHole + mic del headset) y manda la salida del
#            sistema al Multi-Output Device para que BlackHole reciba el lado remoto.
#   mac      Micrófono interno del MacBook, sin tocar la salida: con bocinas, el
#            mismo micrófono capta tu voz y la de los demás.
MIC_SOURCE="auto"

# --- Servicios ---
SERVICES_ENABLE="agent-flow centro-mando"

# --- Rutas locales ---
OLLAMA_BIN="/opt/homebrew/bin/ollama"
