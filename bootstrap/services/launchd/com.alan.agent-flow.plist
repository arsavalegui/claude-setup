<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alan.agent-flow</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN_DIR__/agent-flow</string>
    <string>--no-open</string>
    <string>--port</string>
    <string>3001</string>
  </array>
  <!-- agent-flow registra su cwd como "workspace" y hook.js solo le reenvía las
       sesiones que cuelgan de ahí. launchd arranca en / y nada cuelga de "//";
       systemd --user arranca en $HOME, así que aquí se iguala. -->
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_FLOW_TELEMETRY</key>
    <string>false</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-flow.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-flow.log</string>
</dict>
</plist>
